# Batch Employee Management Configuration for Add Employees Batch Skill
#
# Copy this file to batch_employees_config.yml and update with your actual values

team:
  id: 1  # Replace with your company team ID (optional)

admin:
  username: "admin"  # Replace with your admin username
  password: "your_password_here"  # Replace with your admin password

api:
  base_url: "http://localhost:8080"  # Replace with your Vikunja instance base URL (without /api/v1)
